:3000 {
  root * /srv

  encode gzip

  @static {
    path /assets/*
    path /favicon.ico
    path *.png *.jpg *.jpeg *.gif *.svg *.webp
    path *.js *.css
  }
  header @static Cache-Control "public, max-age=31536000, immutable"

  try_files {path} /index.html

  file_server

  log {
    output stdout
    format json
  }
}
