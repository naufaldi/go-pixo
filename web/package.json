    "@testing-library/jest-dom": "^6.6.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/ui": "^2.1.8",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "rescript": "^12.0.2",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^2.1.8"
