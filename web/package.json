{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build:wasm": "cd .. && ./scripts/build-wasm.sh",
    "build": "rescript build && vite build",
    "build:cloudflare": "npm run build:wasm && npm run build",
    "deploy:dry-run": "npm run build:cloudflare && wrangler deploy --config ../wrangler.jsonc --dry-run",
    "deploy": "npm run build:cloudflare && wrangler deploy --config ../wrangler.jsonc",
    "preview": "vite preview",
    "rescript:build": "rescript build",
    "rescript:watch": "rescript watch",
    "rescript:clean": "rescript clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:browser-verify": "node e2e/browser-verify.mjs",
    "benchmark:fixture": "node e2e/benchmark/generate-fixture.mjs",
    "benchmark:metrics-test": "node --test e2e/benchmark/metrics.unit.mjs",
    "benchmark:e2e": "node e2e/benchmark/run-benchmark.mjs",
    "benchmark:e2e:quick": "node e2e/benchmark/run-benchmark.mjs --iterations=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rescript/react": "^0.15.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^5.0.5",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "rescript": "^12.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@rescript/runtime": "^12.3.1",
    "fflate": "^0.8.3",
    "libheif-js": "^1.23.5",
    "pako": "3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "utif": "^3.1.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.3"
}
