{
  "$schema": "./web/node_modules/wrangler/config-schema.json",
  "name": "go-pixo",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "go-pixo.naufaldi.com/*",
      "zone_name": "naufaldi.com"
    }
  ]
}
